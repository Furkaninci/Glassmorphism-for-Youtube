{
  "manifest_version": 3,
  "name": "Glassmorphism for Youtube",
  "version": "1.0",
  "description": "It transforms the YouTube interface into the Glassmorphism theme.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "css": ["styles/youtube-override.css"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Glassmorphism Settings"
  }
  
}